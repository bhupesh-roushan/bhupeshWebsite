{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/projects/cloudwatch.html",
        "http://localhost/projects/atlas.html",
        "http://localhost/404.html",
        "http://localhost/writing/atlas-constrained-decoding.html",
        "http://localhost/writing/atlas-false-failures.html",
        "http://localhost/writing/cloudwatch-cookie-origin.html",
        "http://localhost/writing/buildingblocks-mixed-content.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "//": "The 404 is deliberately noindex, so the SEO category can never pass here \u2014 is-crawlable is a failure by design. Everything else is still held to the same bar, which is how its 4.43:1 contrast bug was caught.",
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        },
        {
          "//": "Every indexable page.",
          "matchingUrlPattern": "^(?!.*404\\.html).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 300
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
